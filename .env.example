# Copie este arquivo para .env (local) ou configure as mesmas variáveis
# como env vars do processo em produção (Vercel/systemd). Nunca commite o
# .env real.

# --- Banco de dados (Supabase Postgres) -------------------------------------
# String de conexão completa, com senha. No Supabase: Project Settings →
# Database → Connection string → "Transaction pooler" (porta 6543) — o modo
# certo para ambientes serverless como o Vercel.
DATABASE_URL=

# --- Arquivos por contato (Supabase Storage) --------------------------------
# Project Settings → API. SUPABASE_SERVICE_ROLE_KEY é secreta (bypassa RLS) —
# nunca exponha no client, só é usada nos server actions/route handlers.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessão ------------------------------------------------------------------
# String aleatória usada para assinar os cookies de sessão.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- OAuth2 do Google Calendar (criado no Google Cloud Console) -------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL completa de callback registrada no Google Cloud Console, ex:
# https://seu-projeto.vercel.app/api/google/callback
GOOGLE_REDIRECT_URI=
# ID do calendário compartilhado da empresa (ou "primary" para o calendário
# principal da conta conectada).
GOOGLE_CALENDAR_ID=primary

# --- Seed do primeiro admin ---------------------------------------------------
# Usados apenas pelo script `npm run db:seed`.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
