[Unit]
Description=Arte Saunas — app de gestão (Next.js)
After=network.target

[Service]
Type=simple
User=artesaunas
Group=artesaunas
WorkingDirectory=/opt/artesaunas
EnvironmentFile=/opt/artesaunas/.env
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/artesaunas/.next/standalone/server.js
Restart=on-failure
RestartSec=5
# Hardening: the service only needs to read the repo (for static assets) and
# read/write the sqlite file under data/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/artesaunas/data

[Install]
WantedBy=multi-user.target
